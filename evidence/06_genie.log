=== Q: Which systems have the most overdue critical findings? | status: COMPLETED
SQL: WITH ranked_systems AS (
  SELECT
    `system_id`,
    `system_name`,
    `criticality`,
    `overdue_findings`,
    `critical_findings`,
    RANK() OVER (
      ORDER BY `overdue_findings` DESC, `critical_findings` DESC
    ) AS `system_rank`
  FROM `serverless_stable_seg9n6_catalog`.`vuln_poam`.`gold_system_risk`
  WHERE `overdue_findings` IS NOT NULL
    AND `critical_findings` IS NOT NULL
)
SELECT
  `system_id`,
  `system_name`,
  `criticality`,
  `overdue_findings`,
  `critical_findings`
FROM ranked_systems
WHERE `system_rank` <= 10
ORDER BY `overdue_findings` DESC, `critical_findings` DESC, `system_id`
